name: 'B站去开屏（小满）'
desc: |-
  清掉 bilibili App 的开屏广告位，只动 app.bilibili.com 的 splash 接口。
  导入本覆写后，还要到「MitM」里生成并信任证书，否则脚本不会执行。
author: 小满
homepage: 'https://1123user.github.io/349-checkin/'
date: '2026-10-30'
version: '1.0.0'

http:
  mitm:
    - 'app.bilibili.com:443'
  script:
    - name: bili-splash
      match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list
      type: response
      require-body: true
      timeout: 10
      max-size: 1048576

script-providers:
  bili-splash:
    url: https://1123user.github.io/349-checkin/bili/bili-splash.js
    interval: 86400
