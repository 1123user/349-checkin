# B 站去开屏（轻量单条，payload 内联）
# 只动 app.bilibili.com/x/v2/splash/list；不改登录 / 播放 / 弹幕。
# 零收集：脚本内无任何联网、无存储写入（tools/audit_no_collect.py 把关）。
name: B站去开屏（小满）
desc: 清掉 bilibili App 的开屏广告位；脚本内联，不依赖任何外部地址
author: 小满
homepage: https://1123user.github.io/349-checkin/
http:
  mitm:
  - app.bilibili.com:443
  script:
  - name: bili-splash-local
    match: ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list
    type: response
    require-body: true
    timeout: 5
    max-size: 1048576
script-providers:
  bili-splash-local:
    interval: 86400
    payload: "/*\n * B 站 App 去开屏广告（小满版，2026-10-30）\n * 作用：把 app.bilibili.com/x/v2/splash/list 返回的广告位清空，\n *       App 拿不到素材就只能显示自己的默认启动图。\n * 兼容：Surge / Loon / Stash / Quantumult X / Shadowrocket（都是 $response + $done）\n * 只动开屏接口，不碰登录 / 播放 / 弹幕。\n */\nvar raw = \"\";\ntry { raw = ($response && $response.body) || \"\"; } catch (e) { raw = \"\"; }\n\n/* 没拿到 body（客户端没开 require-body / requires-body）就原样放行。\n   这里绝不能 $done({ body: \"\" }) —— 那会把响应写成空，B 站直接白屏。 */\nif (!raw || typeof raw !== \"string\") {\n  $done({});\n} else {\n  var out = raw;\n  try {\n    var j = JSON.parse(raw);\n    var d = j && j.data;\n    if (Array.isArray(d)) {\n      j.data = [];\n    } else if (d && typeof d === \"object\") {\n      var keys = [\"list\", \"splash_list\", \"items\", \"data\"];\n      for (var i = 0; i < keys.length; i++) {\n        var k = keys[i];\n        if (Array.isArray(d[k]) && d[k].length > 0) d[k] = [];\n      }\n      if (d.splash) d.splash = null;\n      if (d.splash_image) d.splash_image = null;\n      /* 顺带把「下次最早什么时候再拉」推到一天后 */\n      if (typeof d.min_interval === \"number\") d.min_interval = 86400;\n    }\n    out = JSON.stringify(j);\n  } catch (e) {\n    out = raw;      /* 结构不认识就原样放行，绝不因一条规则把 App 弄坏 */\n  }\n  $done({ body: out });\n}\n"
