#!name=B站去开屏（小满）
#!desc=清掉 bilibili App 的开屏广告位，只动 app.bilibili.com 的 splash 接口。装完记得在代理 App 里信任 MitM 证书。
#!system=ios

[Script]
bili-splash = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list,requires-body=1,max-size=0,script-path=https://1123user.github.io/349-checkin/bili/bili-splash.js,timeout=10

[MITM]
hostname = %APPEND% app.bilibili.com
