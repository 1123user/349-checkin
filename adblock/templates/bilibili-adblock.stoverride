# B站 去广告（模板，仅供 tools/build_adblock.py 拼装）
# 源：zzzghoul5-bit/stash-ios-app-adblock overrides/Bilibili-ADBlock.stoverride 2026-07-30 v1.1.0
# 覆盖开屏 splash/show|list|brand/list|event/list2 + 首页 feed/index、竖屏 story
# 已改为 payload 内联、删远端 url、删本机日志
name: B站 App 去广告（保守版）
desc: 仅处理已审计的开屏、首页推荐流和竖屏故事广告；不改会员、账号、地区或清晰度。
category: 广告过滤
date: '2026-07-30'
version: 1.1.0
http:
  mitm:
  - app.bilibili.com
  - app.biliapi.net
  script:
  - match: ^https:\/\/app\.(?:bilibili\.com|biliapi\.net)\/x\/v2\/(?:splash\/(?:show|list|brand\/list|event\/list2)|feed\/index(?:\/story)?)(?:\?|$)
    name: local-bilibili-adblock
    type: response
    require-body: true
    max-size: 2097152
    timeout: 10
script-providers:
  local-bilibili-adblock:
    payload: "(() => {\n  \"use strict\";\n\n  const requestUrl =\n    typeof $request !== \"undefined\" && typeof $request.url === \"string\"\n      ? $request.url\n      : \"\";\n  const originalBody =\n    typeof $response !== \"undefined\" && typeof $response.body === \"string\"\n      ? $response.body\n      : \"\";\n  let finished = false;\n\n  function finish(result) {\n    if (!finished) {\n      finished = true;\n      $done(result || {});\n    }\n  }\n\n  function isObject(value) {\n    return value !== null && typeof value === \"object\" && !Array.isArray(value);\n  }\n\n  function hasOwn(object, key) {\n    return Object.prototype.hasOwnProperty.call(object, key);\n  }\n\n\n  function parseRequest(url) {\n    const match = /^https:\\/\\/([^/?#]+)(\\/[^?#]*)?(?:[?#]|$)/i.exec(url);\n    return match\n      ? { host: match[1].toLowerCase(), path: match[2] || \"/\" }\n      : null;\n  }\n\n  try {\n    if (!requestUrl || !originalBody) {\n      finish({});\n      return;\n    }\n\n    const request = parseRequest(requestUrl);\n    const allowedHosts = [\"app.bilibili.com\", \"app.biliapi.net\"];\n    if (!request || allowedHosts.indexOf(request.host) === -1) {\n      finish({});\n      return;\n    }\n\n    let body;\n    try {\n      body = JSON.parse(originalBody);\n    } catch (_) {\n      finish({});\n      return;\n    }\n\n    if (!isObject(body) || !isObject(body.data)) {\n      finish({});\n      return;\n    }\n\n    let removed = 0;\n    const splashPath =\n      /^\\/x\\/v2\\/splash\\/(?:show|list|brand\\/list|event\\/list2)$/.test(\n        request.path\n      );\n\n    if (splashPath) {\n      [\"event_list\", \"preload\", \"show\"].forEach((key) => {\n        if (hasOwn(body.data, key)) {\n          delete body.data[key];\n          removed += 1;\n        }\n      });\n    } else if (request.path === \"/x/v2/feed/index\") {\n      if (!Array.isArray(body.data.items)) {\n        finish({});\n        return;\n      }\n\n      const basicAdGoto = [\"ad_web_s\", \"ad_av\", \"ad_web_gif\"];\n      const inlineAdGoto = [\n        \"ad_player\",\n        \"ad_inline_3d\",\n        \"ad_inline_eggs\",\n        \"ad_inline_live\"\n      ];\n      const keptItems = [];\n\n      body.data.items.forEach((item) => {\n        if (!isObject(item)) {\n          keptItems.push(item);\n          return;\n        }\n\n        const cardType = item.card_type;\n        const cardGoto = item.card_goto;\n        const isBasicAd =\n          (cardType === \"cm_v1\" || cardType === \"cm_v2\") &&\n          basicAdGoto.indexOf(cardGoto) !== -1;\n        const isInlineAd =\n          cardType === \"cm_v2\" && inlineAdGoto.indexOf(cardGoto) !== -1;\n        const isDoubleAd =\n          cardType === \"cm_double_v9\" && cardGoto === \"ad_inline_av\";\n\n        if (isBasicAd || isInlineAd || isDoubleAd) {\n          removed += 1;\n          return;\n        }\n\n        const isBannerCard =\n          (cardType === \"banner_v8\" || cardType === \"banner_ipad_v8\") &&\n          cardGoto === \"banner\";\n        if (isBannerCard && Array.isArray(item.banner_item)) {\n          const originalLength = item.banner_item.length;\n          item.banner_item = item.banner_item.filter(\n            (banner) => !(isObject(banner) && banner.type === \"ad\")\n          );\n          removed += originalLength - item.banner_item.length;\n\n        }\n\n        keptItems.push(item);\n      });\n\n      body.data.items = keptItems;\n    } else if (request.path === \"/x/v2/feed/index/story\") {\n      if (!Array.isArray(body.data.items)) {\n        finish({});\n        return;\n      }\n\n      const storyAdGoto = [\n        \"vertical_ad_av\",\n        \"vertical_ad_picture\",\n        \"vertical_ad_live\"\n      ];\n      body.data.items = body.data.items.filter((item) => {\n        if (!isObject(item)) {\n          return true;\n        }\n        if (item.card_goto === \"vertical_pgc\") {\n          return true;\n        }\n        const isAd =\n          hasOwn(item, \"ad_info\") ||\n          storyAdGoto.indexOf(item.card_goto) !== -1;\n        if (isAd) {\n          removed += 1;\n          return false;\n        }\n        return true;\n      });\n    } else {\n      finish({});\n      return;\n    }\n\n    if (removed > 0) {\n      void 0;\n      finish({ body: JSON.stringify(body) });\n    } else {\n      finish({});\n    }\n  } catch (error) {\n    const message =\n      error && typeof error.message === \"string\" ? error.message : \"unknown\";\n    void 0;\n    finish({});\n  }\n})();\n"
    interval: 86400
